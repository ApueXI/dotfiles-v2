// Designed for Arch Linux
// Modified from: https://github.com/fastfetch-cli/fastfetch/pull/1025#issuecomment-2177566138
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "arch3",
    // https://patorjk.com/software/taag/#p=testall&f=Bulbhead&t=GGM&x=none&v=4&h=4&w=80&we=false
    "type": "kitty",
    "source": "/home/cred/.config/fastfetch/autofister.jpg",
    "width": 40,
    "padding": {
      "left": 4,
      "top": 1
    }
    // "color": {
    // "1": "green",
    // "2": "cyan"
    // "1": "green",
    // "2": "bright_yellow"
    // }
  },
  "display": {
    "color": {
      "separator": "blue"
    },
    "separator": " | ",
    "constants": [
      ">-----------<+>---------------------------------------------<"
    ]
  },
  "modules": [
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    {
      "type": "kernel",
      "key": "  GII MURIN ",
      "keyColor": "bright_yellow"
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    {
      "type": "uptime",
      "key": "   Uptime   ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "   Shell    ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "   Terminal ",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "   Font     ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "   Packages ",
      "keyColor": "blue"
    },
    {
      "type": "localip",
      "key": "   Local IP ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    },
    {
      "type": "display",
      "key": "   Display  ",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "   CPU      ",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "   GPU      ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "   RAM      ",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "   SWAP     ",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "   Disk     ",
      "keyColor": "cyan"
    },
    {
      "type": "battery",
      "key": "   Battery  ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator"
    }
    // "break",
    // {
    //   "type": "colors",
    //   "paddingLeft": 15
    // }
  ]
}
